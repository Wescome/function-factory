{
	"extends": "../../tsconfig.base.json",
	"compilerOptions": {
		"outDir": "./dist",
		"rootDir": "./src",
		"strict": false,
		"noUncheckedIndexedAccess": false,
		"exactOptionalPropertyTypes": false,
		"noImplicitOverride": false,
		"noImplicitReturns": false
	},
	"include": ["src/**/*.ts"],
	"exclude": ["node_modules", "dist", "**/*.d.ts", "src/**/*.d.ts"]
}
