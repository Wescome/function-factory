{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ff-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // D1 Database
  "d1_databases": [
    { "binding": "DB", "database_name": "ff-factory", "database_id": "6a72d5c3-bcbb-41e3-b29d-d8de5834c3b3" }
  ],

  // Service Bindings — internal Workers, no public route
  "services": [
    { "binding": "GATES", "service": "ff-gates", "entrypoint": "GatesService" },
    { "binding": "QUERY", "service": "ff-gateway", "entrypoint": "QueryService" }
  ],

  // Workflow Binding — triggers FactoryPipeline in ff-pipeline Worker
  "workflows": [
    {
      "name": "factory-pipeline",
      "binding": "PIPELINE",
      "script_name": "ff-pipeline",
      "class_name": "FactoryPipeline"
    }
  ],

  // Phase 2: query-worker runs as a named entrypoint in the same deployment.
  // If query load requires independent scaling, split to separate Worker.

  "vars": {
    "ENVIRONMENT": "production"
  }

  // Secrets (set via `wrangler secret put`):
  //   [DEPRECATED] ARANGO_URL      — ArangoDB removed; use D1 (DB binding)
  //   [DEPRECATED] ARANGO_DATABASE — ArangoDB removed; use D1 (DB binding)
  //   [DEPRECATED] ARANGO_JWT      — ArangoDB removed; use D1 (DB binding)
}
